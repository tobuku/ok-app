# Database — get from Supabase project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Supabase — get from Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe — platform account (for billing + Connect)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET_BILLING=whsec_...
STRIPE_WEBHOOK_SECRET_CONNECT=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM="Receipts <receipts@yourplatformdomain.com>"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# App
APP_URL=http://localhost:3000

# Error monitoring
SENTRY_DSN=https://...@sentry.io/...
